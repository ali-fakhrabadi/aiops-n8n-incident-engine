# Local, non-secret settings. Copy to .env (`make env`) and adjust.
# Secrets live in ./secrets (`make secrets`), never in this file.

# Host ports, published on 127.0.0.1 only (reach them remotely through an SSH tunnel).
AIOPS_HTTP_PORT=8020
N8N_HTTP_PORT=5678

AIOPS_LOG_LEVEL=INFO

# The observability stack on this host: its Alertmanager delivers alerts here and the
# worker reads log context from its Loki (see the README):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.observability.yml
# For any other Loki, set its URL instead (empty: no log context).
AIOPS_LOKI_URL=

# Root-cause analysis: mock (deterministic, no model), ollama (local, private) or openai
# (add docker-compose.openai.yml to COMPOSE_FILE). Ollama on this host must listen on an
# address containers can reach (OLLAMA_HOST), and the model must be pulled.
AIOPS_ANALYZER=mock
AIOPS_LLM_MODEL=llama3.1
AIOPS_OLLAMA_URL=http://host.docker.internal:11434
# CPU threads for Ollama; set it to the cores Ollama may use when it is limited to fewer
# than the host has (empty: one per physical core).
AIOPS_LLM_NUM_THREAD=
# How long one analysis may take, and how much of the logs goes into the prompt. A CPU
# reads a long prompt slowly: on an 8-core Broadwell, prompts with about 70 distinct log
# lines took longer than 5 minutes. Keep AIOPS_CLAIM_IDLE_SECONDS longer than the
# timeout, or another worker claims an analysis that is still running.
AIOPS_LLM_TIMEOUT_SECONDS=300
AIOPS_LLM_MAX_LOG_LINES=150
AIOPS_LLM_MAX_LOG_CHARS=12000
AIOPS_CLAIM_IDLE_SECONDS=600

# Notifications: the worker hands every analysed incident to n8n's routing workflow.
# Set this empty to turn notifications off.
#AIOPS_N8N_WEBHOOK_URL=

# Telegram. The bot token goes in secrets/telegram_bot_token (never here); the chat is
# a user, a group or a channel the bot may post to: its numeric ID (groups and
# channels are negative) or @channelname. `make telegram-test` checks both, and
# `make n8n-setup` applies changes to a running stack.
TELEGRAM_CHAT_ID=
# A self-hosted Bot API server (or the fake one in docker-compose.fake-telegram.yml).
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Optional proxy for n8n's outbound requests, reachable from the container (a proxy on
# this host is http://host.docker.internal:PORT). Extra NO_PROXY hosts are added to the
# internal ones, which always bypass it.
N8N_HTTPS_PROXY=
N8N_NO_PROXY=

# n8n's owner account (password: secrets/n8n_owner_password). There is no setup page.
N8N_OWNER_EMAIL=owner@example.com

# n8n: the URL n8n uses for its own webhook URLs and links.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=UTC

# Optional PyPI mirror for image builds and `make lock` (hash pinning keeps it safe).
PIP_INDEX_URL=
